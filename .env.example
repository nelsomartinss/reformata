# Public site URL used by metadata and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulário "Reportar um problema" (envio pelo Resend: https://resend.com).
# As duas primeiras são obrigatórias para o formulário funcionar.
# Sem domínio verificado, o Resend só entrega para o e-mail da sua própria conta.
RESEND_API_KEY=
FEEDBACK_TO=
# Opcional: remetente das mensagens.
FEEDBACK_FROM=Reformata <onboarding@resend.dev>
